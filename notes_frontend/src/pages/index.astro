---
import AppLayout from '../layouts/AppLayout.astro';
import type { Note } from '../services/notesApi';
const q = Astro.url.searchParams.get('q') || '';
const pageTitle = q ? `Search: ${q}` : 'All Notes';
---
<AppLayout title={pageTitle}>
  <section>
    <div class="list-header">
      <h2>{pageTitle}</h2>
      <a class="accent" href="/new">+ New Note</a>
    </div>
    <div id="notes-grid" class="grid" aria-live="polite" aria-busy="true">
      <div class="loading">Loading notes…</div>
    </div>
  </section>
</AppLayout>

<script>
  import { listNotes } from '../services/notesApi';

  const grid = document.getElementById('notes-grid');
  async function load() {
    if (!grid) return;
    try {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q') || undefined;
      const notes = await listNotes(q);
      render(notes);
    } catch (e) {
      grid.innerHTML = `<div class="error">Failed to load notes. ${e instanceof Error ? e.message : ''}</div>`;
    } finally {
      grid.setAttribute('aria-busy', 'false');
    }
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;', "'":'&#039;'}[c]));
  }

  function render(notes) {
    if (!notes || notes.length === 0) {
      grid.innerHTML = `<div class="empty">No notes found.</div>`;
      return;
    }
    grid.innerHTML = notes.map(n => {
      const preview = (n.content || '').slice(0, 160);
      const time = new Date(n.updated_at || n.created_at).toLocaleString();
      const tags = (n.tags || []).map(t => `<span class="tag">${escapeHtml(t)}</span>`).join('');
      return `
        <a class="card" href="/notes/${encodeURIComponent(n.id)}" aria-label="Open note ${escapeHtml(n.title)}">
          <h3>${escapeHtml(n.title || 'Untitled')}</h3>
          <p>${escapeHtml(preview)}</p>
          <div class="meta">
            <time>${escapeHtml(time)}</time>
            <div class="tags">${tags}</div>
          </div>
        </a>
      `;
    }).join('');
  }

  load();
</script>

<style>
.list-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 14px;
}
@media (max-width: 1200px){ .grid { grid-template-columns: repeat(3,1fr);} }
@media (max-width: 900px){ .grid { grid-template-columns: repeat(2,1fr);} }
@media (max-width: 560px){ .grid { grid-template-columns: 1fr;} }

.card {
  display: grid; gap: 10px; padding: 14px; border: 1px solid var(--border);
  background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow);
}
.card:hover { background: var(--card-hover); }
.card h3 { margin: 0; font-size: 1.05rem; }
.card p { margin: 0; color: var(--muted); min-height: 48px; }
.meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.tags { display: flex; gap: 6px; flex-wrap: wrap; }
.tag { padding: 2px 8px; font-size: 12px; border-radius: 999px; border: 1px solid var(--border); color: var(--muted); }
.loading, .empty, .error { padding: 18px; border: 1px dashed var(--border); border-radius: var(--radius); color: var(--muted); }
</style>
