---
import AppLayout from '../layouts/AppLayout.astro';
---
<AppLayout title="New Note">
  <section class="sheet">
    <header class="sheet-header">
      <h2>Create a new note</h2>
      <a class="ghost" href="/">Back</a>
    </header>

    <form id="note-form" class="note-form" aria-describedby="form-help">
      <div class="field">
        <label for="title">Title</label>
        <input id="title" name="title" required placeholder="Note title" />
      </div>

      <div class="field">
        <label for="content">Content</label>
        <textarea id="content" name="content" rows="12" placeholder="Write your note..." required></textarea>
      </div>

      <div class="field">
        <label for="tags">Tags (comma separated)</label>
        <input id="tags" name="tags" placeholder="work, idea, todo" />
      </div>

      <p id="form-help" class="muted">Use the orange button to save your note.</p>

      <div class="actions">
        <button type="button" class="ghost" onclick="history.back()">Cancel</button>
        <button type="submit" class="accent">Save Note</button>
      </div>
    </form>
    <div id="form-status" role="status" class="muted" aria-live="polite"></div>
  </section>
</AppLayout>

<script>
  import { createNote } from '../services/notesApi';

  const form = document.getElementById('note-form');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = 'Saving...';
    try {
      const fd = new FormData(form);
      const title = (fd.get('title') || '').toString().trim();
      const content = (fd.get('content') || '').toString().trim();
      const tagsRaw = (fd.get('tags') || '').toString();
      const tags = tagsRaw.split(',').map(s => s.trim()).filter(Boolean);
      const note = await createNote({ title, content, tags });
      status.textContent = 'Saved.';
      window.location.href = `/notes/${encodeURIComponent(note.id)}`;
    } catch (err) {
      status.textContent = `Failed to save: ${err instanceof Error ? err.message : 'Unknown error'}`;
    }
  });
</script>

<style>
.sheet { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow); }
.sheet-header { display:flex; align-items:center; justify-content: space-between; margin-bottom: 10px; }
.note-form { display: grid; gap: 12px; }
.field { display: grid; gap: 6px; }
label { font-weight: 600; }
input, textarea { padding: 10px 12px; }
.actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 8px; }
.muted { color: var(--muted); }
.accent { background: var(--color-accent); color: #111827; border-color: transparent; }
.ghost { background: transparent; border: 1px solid var(--border); }
</style>
